{
  "manifest_version": 3,
  "name": "Connection Cleanup for LinkedIn",
  "version": "0.2.0",
  "description": "Filter your official LinkedIn connections export, review the list, then remove the ones you picked — one at a time, with a receipt.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": [
        "src/core.js",
        "src/csv.js",
        "src/remover.js",
        "src/panel.js",
        "src/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
